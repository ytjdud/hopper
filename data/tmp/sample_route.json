{
  "$schema": {
    "Route": {
      "description": "출발지에서 도착지까지의 멀티모달 경로",
      "fields": {
        "route_id": "string — 경로 고유 ID",
        "origin": "Place — 출발지",
        "destination": "Place — 도착지",
        "total_duration_min": "number — 총 소요시간(분)",
        "total_transfers": "number — 환승 횟수",
        "legs": "Leg[] — 경로 구간 목록 (순서대로)"
      }
    },
    "Place": {
      "description": "장소 정보",
      "fields": {
        "name": "string — 장소명",
        "type": "string — ORIGIN | DESTINATION | BUS_STOP",
        "lat": "number | null — 위도",
        "lng": "number | null — 경도"
      }
    },
    "Leg": {
      "description": "경로의 한 구간 (도보 또는 버스)",
      "fields": {
        "seq": "number — 구간 순서 (1부터)",
        "type": "string — WALK | BUS",
        "duration_min": "number — 소요시간(분)",
        "start_name": "string — 구간 출발지명",
        "end_name": "string — 구간 도착지명",
        "bus": "BusInfo | null — 버스 구간일 때만 존재"
      }
    },
    "BusInfo": {
      "description": "버스 탑승 정보",
      "fields": {
        "route_name": "string — 버스 노선명 (예: 9409, 1151)",
        "board_stop": "string — 승차 정류장명",
        "alight_stop": "string — 하차 정류장명"
      }
    }
  },
