APP=hopper

build:

run:
	go run ./cmd/server

docker-build:

docker-run:
# Docker Compose Commands

# Development environment
compose-up:

compose-down:

compose-logs:

compose-rebuild:

# NHN Cloud Registry Deployment
deploy:
	@./deploy.sh 1.0.0

deploy-version:
	@./deploy.sh $(VERSION)

deploy-help:
	@echo "배포 명령어:"
	@echo "  make deploy              - 기본 버전(1.0.0)으로 배포"
	@echo "  make deploy-version VERSION=2.0.0  - 특정 버전으로 배포"